# User-configurable paths. Empty values use the documented application defaults.
LEADGEN_ROOT=
LEADGEN_HERMES_ROOT=
HERMES_HOME=
LEADGEN_PYTHON=
LEADGEN_CHARTER=
LEADGEN_RENDER_BUNDLE=

# Execution. Default backend is docker and default image is leadgen-worker:local.
LEADGEN_EXECUTION_BACKEND=
LEADGEN_DOCKER_IMAGE=
LEADGEN_MAX_CONCURRENCY=
LEADGEN_MODEL_BASE_URL=
LEADGEN_SOURCE_RESTRICTION_LIMIT=
LEADGEN_SOURCE_RESTRICTION_BACKOFF_SECONDS=

# Optional diagnostics.
CHROME_TEARDOWN_DEBUG=

# Experimental Jev integration; disabled unless the corresponding flag is true.
JEV_SHADOW_ENABLED=
JEV_SHADOW_OWNER=
JEV_SHADOW_REVIEW_REPLY=
JEV_SHADOW_DIR=
JEV_AB_ENABLED=
JEV_AB_OWNER=
JEV_AB_MAPS=
JEV_AB_OWNER_T=
JEV_AB_MAPS_T=
JEV_AB_DIR=
TYPESAFE_API_KEY=

# Launcher-managed variables. Normally leave these empty.
LEADGEN_CONTAINER=
LEADGEN_ROLE=
BROWSER_CDP_URL=
AGENT_BROWSER_EXECUTABLE_PATH=
AGENT_BROWSER_HEADED=
HERMES_PROFILE=
HERMES_API_TIMEOUT=
HERMES_API_CALL_STALE_TIMEOUT=
HERMES_KANBAN_DB=
HERMES_KANBAN_WORKSPACES_ROOT=
HERMES_KANBAN_BOARD=
TERMINAL_CWD=
